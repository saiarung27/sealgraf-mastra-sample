# Sealgraf — get an agent-scope API key and your permission-slip id from your
# Sealgraf account (the owner issues the key; the slip id is printed on the slip).
SEALGRAF_API_KEY=
SEALGRAF_MANDATE_ID=
# Optional: point the sample at a different Sealgraf deployment (staging
# or a local test double). Defaults to https://sealgraf.com.
# SEALGRAF_BASE_URL=
# The agent id named on the slip. It must match exactly.
SEALGRAF_AGENT_ID=procurement-agent

# A model for the agent (any provider Mastra supports works).
MODEL_ID=openai/gpt-4o-mini
